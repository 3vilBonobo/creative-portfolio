+@media (min-width: 1101px) {
+  .floor-nav {
+    width: 10rem;
+    right: 1rem;
+  }
+  .floor-nav a {
+    grid-template-columns: 1.5rem minmax(0, 1fr) 0.5rem;
+    gap: 0.4rem;
+  }
+  .floor-nav a b {
+    max-width: none;
+  }
+  .about,
+  .projects {
+    padding-right: 12rem;
+  }
+  .about__layout,
+  .projects__header,
+  .projects-gallery,
+  .projects__more {
+    width: min(84rem, calc(100% - 2 * var(--space)));
+  }
+  .experience__scene {
+    padding-right: 12rem;
+  }
+  .experience__content {
+    width: calc(100% - clamp(16rem, 31vw, 34rem));
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+    column-gap: clamp(1.5rem, 2vw, 2rem);
+  }
+  .experience__heading {
+    flex-wrap: wrap;
+    gap: 0.75rem;
+  }
+  .app-shell[data-active-floor="office"] .floor-nav,
+  .app-shell[data-active-floor="street"] .floor-nav {
+    width: 4.5rem;
+    padding: 0.4rem;
+  }
+  .app-shell[data-active-floor="office"] .floor-nav a,
+  .app-shell[data-active-floor="street"] .floor-nav a {
+    grid-template-columns: 1.5rem 0.5rem;
+    padding-inline: 0.35rem;
+  }
+  .app-shell[data-active-floor="office"] .floor-nav a b,
+  .app-shell[data-active-floor="street"] .floor-nav a b {
